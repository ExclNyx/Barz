{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "barz/barz-api",
  "type": "project",
  "description": "Laravel REST API for Barz Barbershop",
  "keywords": ["laravel", "barz", "rest-api", "jwt"],
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "tymon/jwt-auth": "^2.3"
  },
  "require-dev": {},
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {},
  "scripts": {
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {"php-http/discovery": true}
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
