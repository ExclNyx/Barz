                                            <div class="flex items-center gap-3 mb-4">
                                                <span class="w-8 h-8 rounded-full bg-barz-accent text-white flex items-center justify-center font-bold text-sm">3</span>
                                                <h3 class="text-xl font-heading font-bold text-barz-dark">Catatan (Opsional)</h3>
                                            </div>
                        <textarea class="w-full px-4 py-3 rounded-xl border border-barz-border focus:outline-none focus:border-barz-accent focus:ring-2 focus:ring-barz-accent/20 transition-colors" name="notes" rows="3" placeholder="Contoh: Model undercut, rapihkan samping..."></textarea>
                    </div>

                    <button type="submit" class="w-full bg-barz-accent text-white px-6 py-4 rounded-2xl font-bold text-lg hover:bg-barz-accent-hover transition-colors shadow-sm disabled:opacity-50 disabled:cursor-not-allowed" id="submitBtn" disabled>
