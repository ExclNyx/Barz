                        <div class="mb-6">
                            <label class="block text-sm font-medium text-barz-dark mb-3">Tanggal</label>
                            <div class="grid grid-cols-7 gap-2" id="calendarGrid">
                                <!-- Generated by JS -->
                            </div>
