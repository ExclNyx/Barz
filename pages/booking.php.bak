                                <div class="p-5 border-2 border-barz-border rounded-2xl hover:border-barz-accent/50 peer-checked:border-barz-accent peer-checked:bg-barz-accent/5 transition-all">
                                    <h4 class="font-bold text-barz-dark mb-1"><?php echo htmlspecialchars($service['name']); ?></h4>
